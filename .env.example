# --- Database
POSTGRES_USER=wq
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=wellnessquest
DATABASE_URL=postgresql+asyncpg://wq:change-me-strong@postgres:5432/wellnessquest

# --- Backend
# 32 random bytes hex/base64 (e.g. python -c "import secrets;print(secrets.token_urlsafe(32))")
JWT_SECRET=change-me-jwt-secret
# Fernet key (e.g. python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
FERNET_KEY=change-me-fernet-key-base64
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000,https://wellnessquest.lan

# --- Seed (initial admin; rotate after first login)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me-admin
PARTNER_EMAIL=partner@local
PARTNER_PASSWORD=change-me-partner

# --- Frontend
NEXT_PUBLIC_API_BASE=/api/v1

# --- Misc
TZ=America/Toronto
LOG_LEVEL=INFO
