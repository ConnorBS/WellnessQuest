# --- Images (GHCR)
# Owner is your GitHub user/org, lowercase. Tag selects which build to run.
# Tags published by .github/workflows/deploy.yml:
#   :latest / :stable   -- main branch
#   :preview            -- claude/** branches (use this for the slice-1 first run)
#   :sha-<7 chars>      -- every successful build (pin if you want a specific build)
WQ_IMAGE_OWNER=connorbs
WQ_IMAGE_TAG=preview

# --- Host port for the unified container (serves PWA at / and API at /api/v1)
APP_PORT=8000

# --- Database
POSTGRES_USER=wq
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=wellnessquest
DATABASE_URL=postgresql+asyncpg://wq:change-me-strong@postgres:5432/wellnessquest

# --- Backend
# 32 random bytes (e.g. python -c "import secrets;print(secrets.token_urlsafe(32))")
JWT_SECRET=change-me-jwt-secret
# Fernet key (e.g. python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
FERNET_KEY=change-me-fernet-key-base64
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Comma-separated allowed origins. Same-origin requests from the bundled PWA do
# not need to appear here; add additional origins only if you proxy the app
# behind a different hostname or call the API directly from another web app.
CORS_ORIGINS=http://localhost:8000,http://wellnessquest.lan:8000

# --- Seed (initial admin; rotate after first login)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me-admin
PARTNER_EMAIL=partner@local
PARTNER_PASSWORD=change-me-partner

# --- Misc
TZ=America/Toronto
LOG_LEVEL=INFO
